    owl:versionInfo              "1.0.0" ;
    owl:versionIRI               <https://w3id.org/citydata/part3/v1/Transport/r0.0> ;
    rdfs:seeAlso                 <https://www.iso.org/standard/87441.html> ;
    dcterms:bibliographicCitation "ISO/IEC 5087-3" ;
