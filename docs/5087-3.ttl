<https://w3id.org/citydata/part3/v1/>
    rdf:type                     owl:Ontology ;
    dcterms:title                "Information technology - City data model - Part 3: Service level concepts - Transport" ;
    skos:definition              "This ontology specifies the service-level concepts defined for the transport service of the city data model."@en ;
