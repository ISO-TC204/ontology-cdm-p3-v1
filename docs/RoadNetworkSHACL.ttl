@prefix : <https://w3id.org/citydata/part3/v1/> .
@prefix cdm3: <https://w3id.org/citydata/part3/v1/> .
@prefix cdm1: <https://w3id.org/citydata/part1/v1/> .
@prefix cdm2: <https://w3id.org/citydata/part2/v1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .

:RoadNetworkSHACL
    rdf:type owl:Ontology ;
    dcterms:title "City Data Model Part 3 - RoadNetwork Pattern - SHACL constraints" ;
    skos:definition "SHACL validation shapes for the RoadNetwork Pattern module." ;
    vann:preferredNamespaceUri "https://w3id.org/citydata/part3/v1/" ;
    vann:preferredNamespacePrefix "cdm3" ;
    owl:imports <https://w3id.org/citydata/part3/v1/RoadNetworkPattern/> ;
    owl:imports :CoreSHACL .

:RoadShape
    rdf:type sh:NodeShape ;
    sh:targetClass :Road ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:node :MinOneShape ;
        sh:class :RoadLink
    ] ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:class :RoadNetwork
    ] .

:RoadLaneShape
    rdf:type sh:NodeShape ;
    sh:targetClass :RoadLane ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:node :MinOneShape ;
        sh:class :RoadSegment
    ] ;
    sh:property [
        sh:path :next ;
        sh:class :RoadLane
    ] ;
    sh:property [
        sh:path :previous ;
        sh:class :RoadLane
    ] ;
    sh:property [
        sh:path :width ;
        sh:node :ExactlyOneShape ;
        sh:class cdm1:Length
    ] .

:RoadLinkShape
    rdf:type sh:NodeShape ;
    sh:targetClass :RoadLink ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:class :RoadSegment
    ] ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:or (
            [ sh:class :Road ]
            [ sh:class :RoadNetwork ]
            [ sh:class :RoadSection ]
        )
    ] ;
    sh:property [
        sh:path :capacity ;
        sh:node :ExactlyOneShape ;
        sh:class :VehicleFlowRate
    ] ;
    sh:property [
        sh:path :maxLanes ;
        sh:node :ExactlyOneShape ;
        sh:datatype xsd:nonNegativeInteger
    ] ;
    sh:property [
        sh:path :primaryUser ;
        sh:class :RoadLinkUserType
    ] ;
    sh:property [
        sh:path :travelTime ;
        sh:node :MaxOneShape ;
        sh:class <https://w3id.org/citydata/part1/v1/CityUnits/Duration>
    ] ;
    sh:property [
        sh:path :usedBy ;
        sh:class :RoadLinkUserType
    ] .

:RoadLinkUserTypeShape
    rdf:type sh:NodeShape ;
    sh:targetClass :RoadLinkUserType ;
    sh:property [
        sh:path :speedLimit ;
        sh:node :MaxOneShape ;
        sh:class <https://w3id.org/citydata/part1/v1/CityUnits/Speed>
    ] ;
    sh:property [
        sh:path :travelTime ;
        sh:node :MaxOneShape ;
        sh:class <https://w3id.org/citydata/part1/v1/CityUnits/Duration>
    ] ;
    sh:property [
        sh:path :userCategory ;
        sh:node :ExactlyOneShape ;
        sh:class cdm2:Code
    ] ;
    sh:property [
        sh:path :uses ;
        sh:class :RoadLink
    ] .

:RoadNetworkShape
    rdf:type sh:NodeShape ;
    sh:targetClass :RoadNetwork ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:node :MinOneShape ;
        sh:or (
            [ sh:class :Road ]
            [ sh:class :RoadLink ]
            [ sh:class :RoadSection ]
        )
    ] .

:RoadSectionShape
    rdf:type sh:NodeShape ;
    sh:targetClass :RoadSection ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:or (
            [ sh:class :RoadLink ]
            [ sh:class :RoadSegment ]
        )
    ] ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:class :RoadNetwork
    ] .

:RoadSegmentShape
    rdf:type sh:NodeShape ;
    sh:targetClass :RoadSegment ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:node :MinOneShape ;
        sh:class :RoadLane
    ] ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:node :ExactlyOneShape ;
        sh:or (
            [ sh:class :RoadLink ]
            [ sh:class :RoadSection ]
        )
    ] ;
    sh:property [
        sh:path :numLanes ;
        sh:node :ExactlyOneShape ;
        sh:datatype xsd:nonNegativeInteger
    ] ;
    sh:property [
        sh:path :pavementType ;
        sh:node :MaxOneShape ;
        sh:class cdm2:Code
    ] ;
    sh:property [
        sh:path :width ;
        sh:node :ExactlyOneShape ;
        sh:class cdm1:Length
    ] .
