@prefix : <https://w3id.org/citydata/part3/v1/> .
@prefix cdm3: <https://w3id.org/citydata/part3/v1/> .
@prefix cdm1: <https://w3id.org/citydata/part1/v1/> .
@prefix cdm2: <https://w3id.org/citydata/part2/v1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .

:PedestrianNetworkSHACL
    rdf:type owl:Ontology ;
    dcterms:title "City Data Model Part 3 - PedestrianNetwork Pattern - SHACL constraints" ;
    skos:definition "SHACL validation shapes for the PedestrianNetwork Pattern module." ;
    vann:preferredNamespaceUri "https://w3id.org/citydata/part3/v1/" ;
    vann:preferredNamespacePrefix "cdm3" ;
    owl:imports <https://w3id.org/citydata/part3/v1/PedestrianNetworkPattern/> ;
    owl:imports :CoreSHACL .

:FootpathShape
    rdf:type sh:NodeShape ;
    sh:targetClass :Footpath ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:node :MinOneShape ;
        sh:class :FootpathLink
    ] ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:class :FootpathNetwork
    ] .

:FootpathLaneShape
    rdf:type sh:NodeShape ;
    sh:targetClass :FootpathLane ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:node :MinOneShape ;
        sh:class :FootpathSegment
    ] .

:FootpathLinkShape
    rdf:type sh:NodeShape ;
    sh:targetClass :FootpathLink ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:node :MinOneShape ;
        sh:class :FootpathSegment
    ] ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:or (
            [ sh:class :Footpath ]
            [ sh:class :FootpathNetwork ]
            [ sh:class :FootpathSection ]
        )
    ] .

:FootpathNetworkShape
    rdf:type sh:NodeShape ;
    sh:targetClass :FootpathNetwork ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:node :MinOneShape ;
        sh:or (
            [ sh:class :Footpath ]
            [ sh:class :FootpathLink ]
            [ sh:class :FootpathSection ]
        )
    ] .

:FootpathSectionShape
    rdf:type sh:NodeShape ;
    sh:targetClass :FootpathSection ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:or (
            [ sh:class :FootpathLink ]
            [ sh:class :FootpathSegment ]
        )
    ] ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:class :FootpathNetwork
    ] .

:FootpathSegmentShape
    rdf:type sh:NodeShape ;
    sh:targetClass :FootpathSegment ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:node :MinOneShape ;
        sh:class :FootpathLane
    ] ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:node :MinOneShape ;
        sh:or (
            [ sh:class :FootpathLink ]
            [ sh:class :FootpathSection ]
        )
    ] .
