@prefix : <https://w3id.org/citydata/part3/v1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cdm1: <https://w3id.org/citydata/part1/v1/> .
@prefix cdm2: <https://w3id.org/citydata/part2/v1/> .
@base <https://w3id.org/citydata/part3/v1/> .

<https://w3id.org/citydata/part3/v1/CorePattern> rdf:type owl:Ontology ;
                                                  owl:imports cdm2:CorePattern ;
                                                  dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
                                                  dcterms:creator "Kenneth Vaughn" ,
                                                                  "Mark Fox" ,
                                                                  "Megan Katsumi" ;
                                                  dcterms:modified "2026-08-14"^^xsd:date ;
                                                  dcterms:title "Information technology - City data model - Part 3: Service level concepts - Core" ;
                                                  vann:preferredNamespacePrefix "cdm3" ;
                                                  vann:preferredNamespaceUri "https://w3id.org/citydata/part3/v1/" ;
                                                  owl:versionIRI <https://w3id.org/citydata/part3/v1/1.0.2-alpha.1> ;
    owl:priorVersion               <https://w3id.org/citydata/part3/v1/1.0.1> ;
                                                  owl:versionInfo "1.0.2-alpha.1" ;
                                                  skos:definition "This ontology specifies the service-level concepts defined for the transport service of the city data model."@en .

#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/citydata/part3/v1/ITSObjectProperty
:ITSObjectProperty rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf cdm1:CdmObjectProperty ;
                   skos:definition "Added for organizational purposes, to identify all object properties defined for the transport service of the City Data Model."@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/citydata/part3/v1/ITSDataProperty
:ITSDataProperty rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf cdm1:CdmDataProperty ;
                 skos:definition "Added for organizational purposes, to identify all data properties defined for the transport service of the City Data Model."@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/citydata/part3/v1/ITSThing
:ITSThing rdf:type owl:Class ;
          rdfs:subClassOf cdm1:CdmThing ;
          skos:definition "Added for organizational purposes, to identify all classes defined for the transport service of the City Data Model."@en .
