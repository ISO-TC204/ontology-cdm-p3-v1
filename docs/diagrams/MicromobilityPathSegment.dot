// Diagram for MicromobilityPathSegment
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		RoadSegment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">RoadSegment</TD></TR></TABLE>> URL="../RoadSegment" margin=0]
	}
	MicromobilityPathSegment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityPathSegment</TD></TR><TR><TD ALIGN="LEFT">cdm1:properPartOf [1..*]</TD></TR></TABLE>> URL="../MicromobilityPathSegment" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		MicromobilityLane [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityLane</TD></TR></TABLE>> URL="../MicromobilityLane" margin=0]
		MicromobilityLink [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityLink</TD></TR></TABLE>> URL="../MicromobilityLink" margin=0]
		MicromobilityPathSection [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityPathSection</TD></TR></TABLE>> URL="../MicromobilityPathSection" margin=0]
	}
	MicromobilityPathSegment -> RoadSegment [arrowhead=onormal style=solid]
	MicromobilityPathSegment -> Invis [style=invis]
	Invis -> MicromobilityLane [style=invis]
	MicromobilityLane -> MicromobilityLink [style=invis]
	MicromobilityLink -> MicromobilityPathSection [style=invis]
	MicromobilityLane [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityLane</TD></TR></TABLE>> URL="../MicromobilityLane" margin=0]
	MicromobilityPathSegment -> MicromobilityLane [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">redefines</TD></TR><TR><TD ALIGN="CENTER">cdm1:hasProperPart</TD></TR><TR><TD ALIGN="CENTER">1..*</TD></TR></TABLE>> arrowhead=normal style=dashed]
	n08b901a28ea24e5d929e965f217f15e3b26 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="lightyellow"><TR><TD ALIGN="CENTER">«unionOf»</TD></TR></TABLE>> margin=0]
	MicromobilityLink [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityLink</TD></TR></TABLE>> URL="../MicromobilityLink" margin=0]
	n08b901a28ea24e5d929e965f217f15e3b26 -> MicromobilityLink [label=member arrowhead=normal style=dotted]
	MicromobilityPathSection [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityPathSection</TD></TR></TABLE>> URL="../MicromobilityPathSection" margin=0]
	n08b901a28ea24e5d929e965f217f15e3b26 -> MicromobilityPathSection [label=member arrowhead=normal style=dotted]
	MicromobilityPathSegment -> n08b901a28ea24e5d929e965f217f15e3b26 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">redefines</TD></TR><TR><TD ALIGN="CENTER">cdm1:properPartOf</TD></TR></TABLE>> arrowhead=normal style=dashed]
	MicromobilityPathSegment -> MicromobilityLink [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">redefines</TD></TR><TR><TD ALIGN="CENTER">cdm1:properPartOf</TD></TR><TR><TD ALIGN="CENTER">1..*</TD></TR></TABLE>> arrowhead=normal style=dashed]
