// Diagram for RoutePoint
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		PublicTransportElement [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PublicTransportElement</TD></TR></TABLE>> URL="../PublicTransportElement" margin=0]
		TransportNode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">TransportNode</TD></TR></TABLE>> URL="../TransportNode" margin=0]
	}
	RoutePoint [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">RoutePoint</TD></TR><TR><TD ALIGN="LEFT">isBorderCrossing : xsd:boolean [1]</TD></TR><TR><TD ALIGN="LEFT">isViaPoint : xsd:boolean [0..1]</TD></TR></TABLE>> URL="../RoutePoint" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
	}
	RoutePoint -> PublicTransportElement [arrowhead=onormal style=solid]
	RoutePoint -> TransportNode [arrowhead=onormal style=solid]
}
