@prefix : <https://w3id.org/citydata/part3/v1/> .
@prefix cdm3: <https://w3id.org/citydata/part3/v1/> .
@prefix cdm1: <https://w3id.org/citydata/part1/v1/> .
@prefix cdm2: <https://w3id.org/citydata/part2/v1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .

:RailNetworkSHACL
    rdf:type owl:Ontology ;
    dcterms:title "City Data Model Part 3 - RailNetwork Pattern - SHACL constraints" ;
    skos:definition "SHACL validation shapes for the RailNetwork Pattern module." ;
    vann:preferredNamespaceUri "https://w3id.org/citydata/part3/v1/" ;
    vann:preferredNamespacePrefix "cdm3" ;
    owl:imports <https://w3id.org/citydata/part3/v1/RailNetworkPattern/> ;
    owl:imports :CoreSHACL .

:RailCorridorShape
    rdf:type sh:NodeShape ;
    sh:targetClass :RailCorridor ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:node :MinOneShape ;
        sh:class :TrackLink
    ] ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:class :RailNetwork
    ] .

:RailNetworkShape
    rdf:type sh:NodeShape ;
    sh:targetClass :RailNetwork ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:node :MinOneShape ;
        sh:or (
            [ sh:class :RailCorridor ]
            [ sh:class :RailSection ]
            [ sh:class :TrackLink ]
        )
    ] .

:RailSectionShape
    rdf:type sh:NodeShape ;
    sh:targetClass :RailSection ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:or (
            [ sh:class :TrackLink ]
            [ sh:class :TrackSegment ]
        )
    ] ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:class :RailNetwork
    ] .

:TrackLinkShape
    rdf:type sh:NodeShape ;
    sh:targetClass :TrackLink ;
    sh:property [
        sh:path cdm1:hasProperPart ;
        sh:class :TrackSegment
    ] ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:or (
            [ sh:class :RailCorridor ]
            [ sh:class :RailNetwork ]
            [ sh:class :RailSection ]
        )
    ] .

:TrackSegmentShape
    rdf:type sh:NodeShape ;
    sh:targetClass :TrackSegment ;
    sh:property [
        sh:path cdm1:properPartOf ;
        sh:node :ExactlyOneShape ;
        sh:or (
            [ sh:class :RailSection ]
            [ sh:class :TrackLink ]
        )
    ] .
