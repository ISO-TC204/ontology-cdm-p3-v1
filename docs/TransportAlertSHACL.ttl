@prefix : <https://w3id.org/citydata/part3/v1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/citydata/part3/v1/> .

<https://w3id.org/citydata/part3/v1/TransportAlertSHACL> rdf:type owl:Ontology ;
    dcterms:modified               "2026-08-14"^^xsd:date ;
                                                          owl:imports :CoreSHACL ,
                                                                      :TransportAlertPattern ;
                                                          dcterms:title "City Data Model Part 3 - TransportAlert Pattern - SHACL constraints" ;
                                                          vann:preferredNamespacePrefix "cdm3" ;
                                                          vann:preferredNamespaceUri "https://w3id.org/citydata/part3/v1/" ;
                                                          skos:definition "SHACL validation shapes for the TransportAlert Pattern module." .

#################################################################
#    Shapes
#################################################################

###  https://w3id.org/citydata/part3/v1/TransportAlertShape
:TransportAlertShape rdf:type sh:NodeShape ;
                     sh:property [ sh:class :NetworkElement ;
                                   sh:path :affects
                                 ] ;
                     sh:targetClass :TransportAlert .
