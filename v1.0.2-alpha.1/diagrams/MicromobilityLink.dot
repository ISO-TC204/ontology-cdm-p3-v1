// Diagram for MicromobilityLink
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		RoadLink [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">RoadLink</TD></TR></TABLE>> URL="../RoadLink" margin=0]
	}
	MicromobilityLink [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityLink</TD></TR><TR><TD ALIGN="LEFT">cdm1:properPartOf</TD></TR></TABLE>> URL="../MicromobilityLink" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		MicromobilityNetwork [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityNetwork</TD></TR></TABLE>> URL="../MicromobilityNetwork" margin=0]
		MicromobilityPath [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityPath</TD></TR></TABLE>> URL="../MicromobilityPath" margin=0]
		MicromobilityPathSection [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityPathSection</TD></TR></TABLE>> URL="../MicromobilityPathSection" margin=0]
		MicromobilityPathSegment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityPathSegment</TD></TR></TABLE>> URL="../MicromobilityPathSegment" margin=0]
	}
	MicromobilityLink -> RoadLink [arrowhead=onormal style=solid]
	MicromobilityLink -> Invis [style=invis]
	Invis -> MicromobilityNetwork [style=invis]
	MicromobilityNetwork -> MicromobilityPath [style=invis]
	MicromobilityPath -> MicromobilityPathSection [style=invis]
	MicromobilityPathSection -> MicromobilityPathSegment [style=invis]
	MicromobilityPathSegment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityPathSegment</TD></TR></TABLE>> URL="../MicromobilityPathSegment" margin=0]
	MicromobilityLink -> MicromobilityPathSegment [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">redefines</TD></TR><TR><TD ALIGN="CENTER">cdm1:hasProperPart</TD></TR><TR><TD ALIGN="CENTER">1..*</TD></TR></TABLE>> arrowhead=normal style=dashed]
	n08b901a28ea24e5d929e965f217f15e3b5 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="lightyellow"><TR><TD ALIGN="CENTER">«unionOf»</TD></TR></TABLE>> margin=0]
	MicromobilityNetwork [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityNetwork</TD></TR></TABLE>> URL="../MicromobilityNetwork" margin=0]
	n08b901a28ea24e5d929e965f217f15e3b5 -> MicromobilityNetwork [label=member arrowhead=normal style=dotted]
	MicromobilityPath [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MicromobilityPath</TD></TR></TABLE>> URL="../MicromobilityPath" margin=0]
